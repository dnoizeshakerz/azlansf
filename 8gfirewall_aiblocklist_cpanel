    # Remove any commented or malformed versions first
    sed -i '/^[#[:space:]]*Include.*8gfirewall.conf/d' "$PRE_VH_GLOBAL"
    
    # Prepend the include line (so it loads before virtual hosts)
    {
        echo ""
        echo "# 8G Firewall Include"
        echo "$INCLUDE_LINE"
        echo ""
        cat "$PRE_VH_GLOBAL"
    } > "${PRE_VH_GLOBAL}.tmp"
    mv "${PRE_VH_GLOBAL}.tmp" "$PRE_VH_GLOBAL"
