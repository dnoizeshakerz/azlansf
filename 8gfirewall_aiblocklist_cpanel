#!/bin/bash

set -euo pipefail

PRE_VH_GLOBAL="/etc/apache2/conf.d/includes/pre_virtualhost_global.conf"
FW_FILE="/etc/apache2/conf.d/includes/8gfirewall.conf"
BACKUP_FILE="${PRE_VH_GLOBAL}.$(date +%Y%m%d-%H%M%S).bak"
INCLUDE_LINE='Include /etc/apache2/conf.d/includes/8gfirewall.conf'

# Ensure directories exist
mkdir -p "$(dirname "$PRE_VH_GLOBAL")"
mkdir -p "$(dirname "$FW_FILE")"

# --- 1. Backup and clean existing 8G rules from pre_virtualhost_global.conf ---
echo "[*] Backing up ${PRE_VH_GLOBAL} -> ${BACKUP_FILE}"
cp -a "$PRE_VH_GLOBAL" "$BACKUP_FILE" 2>/dev/null || touch "$PRE_VH_GLOBAL"

echo "[*] Cleaning any existing 8G Firewall rules from ${PRE_VH_GLOBAL}..."

python3 -c "
import re

with open('${PRE_VH_GLOBAL}', 'r') as f:
    content = f.read()

# Remove the full commented header block + everything until next major section or EOF
pattern = r'#[=\s]+\n#\s*8G Firewall.*?\n(?=\n*[^#\s]|\Z)'
content = re.sub(pattern, '', content, flags=re.DOTALL | re.IGNORECASE)

# Remove any Include lines referencing 8gfirewall.conf
content = re.sub(r'(?im)^\s*Include\s+.*8gfirewall\.conf.*\n?', '', content)

# Remove lines with classic 8G markers
content = re.sub(r'(?im)^\s*.*8G:\[.*?\].*\n?', '', content)

# Remove SetEnvIfNoCase / RewriteCond / RewriteRule lines tied to block_8g
content = re.sub(r'(?im)^\s*(SetEnvIfNoCase|RewriteCond|RewriteRule)\s+.*block_8g.*\n?', '', content)
content = re.sub(r'(?im)^\s*(Require\s+not\s+env\s+block_8g|Deny\s+from\s+env=block_8g).*?\n?', '', content)

# Remove specific header/footer comments used by 8G
content = re.sub(r'(?im)^\s*#\s*-{10,}.*\n?', '', content)
content = re.sub(r'(?im)^\s*#\s*8G\s+Firewall.*\n?', '', content)
content = re.sub(r'(?im)^\s*#\s*PLACE IN:.*\n?', '', content)
content = re.sub(r'(?im)^\s*#\s*REBUILD:.*\n?', '', content)
content = re.sub(r'(?im)^\s*#\s*RESTART:.*\n?', '', content)
content = re.sub(r'(?im)^\s*#\s*HOW IT WORKS:.*\n?', '', content)
content = re.sub(r'(?im)^\s*#\s*PART [A-C]:.*\n?', '', content)

# Clean up excessive blank lines (more than 2 consecutive)
content = re.sub(r'\n{3,}', '\n\n', content)

with open('${PRE_VH_GLOBAL}', 'w') as f:
    f.write(content)

print('Cleaned existing 8G rules from pre_virtualhost_global.conf')
" || {
    echo "[!] Python cleanup failed, using sed fallback..."
    sed -i '/8G Firewall/d' "$PRE_VH_GLOBAL"
    sed -i '/8G:\[/d' "$PRE_VH_GLOBAL"
    sed -i '/block_8g/d' "$PRE_VH_GLOBAL"
    sed -i '/8gfirewall.conf/d' "$PRE_VH_GLOBAL"
    sed -i '/SetEnvIfNoCase.*block_8g/d' "$PRE_VH_GLOBAL"
    sed -i '/Require not env block_8g/d' "$PRE_VH_GLOBAL"
    sed -i '/Deny from env=block_8g/d' "$PRE_VH_GLOBAL"
    sed -i '/PART [A-C]:/d' "$PRE_VH_GLOBAL"
}

# --- 2. Write the 8G rules to the dedicated include file ---
echo "[*] Writing 8G Firewall rules to ${FW_FILE}..."

