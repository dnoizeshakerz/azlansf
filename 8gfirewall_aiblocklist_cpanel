echo "[*] Running Apache config test..."
if apachectl configtest; then
    echo "[+] Apache configuration test PASSED."
else
    echo "[!] Apache configuration test FAILED."
    echo "[*] Restoring backup..."
    cp -a "$BACKUP_FILE" "$PRE_VH_GLOBAL"
