<?php
/**
 * Plugin Name: Serverfreak Instant Cache
 * Description: Ultra-fast full-page caching with gzip, preloading, and cache health warnings. Drop into wp-content/mu-plugins/.
 * Version: 2.0.0-mu
 * Author: Serverfreak
 * Requires PHP: 7.4
 */

if (!defined('ABSPATH')) exit;

class Serverfreak_Instant_Cache {
    private static ?self $instance = null;
    private string $cache_dir;
    private int $ttl;
    private bool $skip = false;
    private ?string $cache_key = null;
    private array $dynamic_page_ids = [];
    private array $dynamic_patterns = [];
    private bool $dynamic_pages_built = false;
    private const MAX_FILE_SIZE = 52428800; // 50MB
    private const HEADER_HIT = 'X-Cache-Status';
    private const HEADER_GZIP = 'X-Cache-Gzip';
    private const PRELOAD_BATCH = 5;
    private const PRELOAD_DELAY = 2;

    public static function instance(): self {
        if (null === self::$instance) {
            self::$instance = new self();
        }
        return self::$instance;
    }

    private function __construct() {
        $this->ttl = (int) apply_filters('serverfreak_cache_ttl', 3600);
        $this->setup_cache_directory();
        $this->register_hooks();
    }

    private function __clone() {}

    private function setup_cache_directory(): void {
        $base_dir = WP_CONTENT_DIR . '/cache/serverfreak-cache/';

        if (is_multisite()) {
            $blog_id = get_current_blog_id();
            $this->cache_dir = $base_dir . 'site-' . $blog_id . '/';
        } else {
            $this->cache_dir = $base_dir . 'default/';
        }

        if (!is_dir($this->cache_dir)) {
            wp_mkdir_p($this->cache_dir);

            $htaccess = $this->cache_dir . '.htaccess';
            if (!file_exists($htaccess)) {
                @file_put_contents($htaccess, "Options -Indexes\nRequire all denied\nOrder deny,allow\nDeny from all\n", LOCK_EX);
            }

            $index = $this->cache_dir . 'index.php';
            if (!file_exists($index)) {
                @file_put_contents($index, "<?php\n// Silence is golden.\n", LOCK_EX);
            }

            $nginx = $this->cache_dir . 'nginx.conf';
            if (!file_exists($nginx)) {
                @file_put_contents($nginx, "deny all;\n", LOCK_EX);
            }
        }

        if (!is_writable($this->cache_dir)) {
            $this->skip = true;
            if (defined('WP_DEBUG') && WP_DEBUG) {
                error_log('Serverfreak Cache: Cache directory not writable: ' . $this->cache_dir);
            }
        }
    }

    private function register_hooks(): void {
        // MU plugin: no activation hook, so write htaccess on init if needed
        add_action('muplugins_loaded', [$this, 'maybe_write_htaccess'], 20);
        
        // Also hook into regular init for late checks
        add_action('init', [$this, 'maybe_write_htaccess'], 1);

        if ($this->early_bail_check_safe()) {
            $this->skip = true;
            return;
        }

        add_action('wp', [$this, 'late_init'], PHP_INT_MIN);

        add_action('save_post', [$this, 'handle_post_save'], 10, 3);
        add_action('woocommerce_order_status_changed', [$this, 'clear_all_cache'], 10, 0);
        add_action('cartflows_order_status_changed', [$this, 'clear_all_cache'], 10, 0);
        add_action('cartflows_step_saved', [$this, 'clear_all_cache'], 10, 0);
        add_action('upgrader_process_complete', [$this, 'clear_all_cache'], 10, 0);
        add_action('switch_theme', [$this, 'clear_all_cache'], 10, 0);
        add_action('wp_trash_post', [$this, 'handle_post_trash'], 10, 1);

        add_filter('mod_rewrite_rules', [$this, 'add_rewrite_rules'], PHP_INT_MAX);

        // === PRELOAD: Trigger after clears ===
        add_action('serverfreak_cache_cleared', [$this, 'schedule_preload'], 10, 0);
        add_action('serverfreak_run_preload', [$this, 'run_preload_batch'], 10, 1);

        // === CACHE WARN: Admin notices (MU-safe) ===
        add_action('admin_notices', [$this, 'show_cache_warnings']);
        // Also show on network admin for multisite
        add_action('network_admin_notices', [$this, 'show_cache_warnings']);

        if (is_multisite()) {
            add_action('wp_uninitialize_blog', [$this, 'handle_blog_delete'], 10, 1);
        }

        if (defined('WP_CLI') && WP_CLI) {
            add_action('cli_init', [$this, 'register_cli_commands']);
        }
    }

    private function early_bail_check_safe(): bool {
        if (is_admin()) return true;
        if (defined('DOING_AJAX') && DOING_AJAX) return true;
        if (defined('DOING_CRON') && DOING_CRON) return true;
        if (defined('REST_REQUEST') && REST_REQUEST) return true;
        if (defined('XMLRPC_REQUEST') && XMLRPC_REQUEST) return true;
        if ($_SERVER['REQUEST_METHOD'] !== 'GET') return true;
        if (isset($_SERVER['REQUEST_URI']) && strpos($_SERVER['REQUEST_URI'], 'robots.txt') !== false) return true;
        if (isset($_SERVER['REQUEST_URI']) && preg_match('/sitemap.*\.xml$/i', $_SERVER['REQUEST_URI'])) return true;
        if (isset($_GET['preview']) || isset($_GET['preview_id'])) return true;
        if (!empty($_SERVER['HTTP_REFERER']) && stripos($_SERVER['HTTP_REFERER'], 'trackback') !== false) return true;
        return false;
    }

    // ==================== CACHE WARN FEATURE ====================

    public function show_cache_warnings(): void {
        if (!current_user_can('manage_options')) return;

        $screen = get_current_screen();
        if ($screen && $screen->is_block_editor()) return;

        $warnings = [];
        $notices = [];

        // Check cache directory writable
        if (!is_writable($this->cache_dir)) {
            $warnings[] = sprintf(
                '<strong>Serverfreak Cache Warning:</strong> Cache directory is not writable: <code>%s</code>. Caching is disabled.',
                esc_html($this->cache_dir)
            );
        }

        // Check .htaccess rules present
        $htaccess_file = ABSPATH . '.htaccess';
        if (file_exists($htaccess_file) && is_readable($htaccess_file)) {
            $content = @file_get_contents($htaccess_file);
            if ($content === false || strpos($content, '# Serverfreak Instant Cache') === false) {
                $fix_url = wp_nonce_url(admin_url('?sic_rewrite=1'), 'sic_rewrite');
                $warnings[] = '<strong>Serverfreak Cache Warning:</strong> Rewrite rules missing from <code>.htaccess</code>. <a href="' . esc_url($fix_url) . '">Click here to fix</a> or <a href="https://github.com/dnoizeshakerz/azlansf/wiki/Manual-htaccess" target="_blank">add manually</a>.';
            }
        } elseif (!is_writable(ABSPATH)) {
            $warnings[] = '<strong>Serverfreak Cache Warning:</strong> Cannot create <code>.htaccess</code>. Please ensure the WordPress root directory is writable or add rules manually.';
        }

        // Check gzip support availability
        if (!function_exists('gzencode')) {
            $warnings[] = '<strong>Serverfreak Cache Warning:</strong> PHP <code>zlib</code> extension is not available. Gzip compression is disabled.';
        }

        // Check disk space (warn if < 100MB)
        $free_space = @disk_free_space($this->cache_dir);
        if ($free_space !== false && $free_space < 100 * 1024 * 1024) {
            $warnings[] = sprintf(
                '<strong>Serverfreak Cache Warning:</strong> Low disk space on cache partition: %s remaining.',
                size_format($free_space)
            );
        }

        // Display warnings
        foreach ($warnings as $warning) {
            printf(
                '<div class="notice notice-warning is-dismissible"><p>%s</p></div>',
                wp_kses_post($warning)
            );
        }

        // Show success if everything is OK
        if (empty($warnings)) {
            $stats = $this->get_stats();
            $gzip_status = function_exists('gzencode') ? 'Enabled' : 'Disabled';
            $preload_status = wp_next_scheduled('serverfreak_run_preload') ? 'Running' : 'Idle';
            
            printf(
                '<div class="notice notice-success is-dismissible"><p><strong>Serverfreak Cache:</strong> Running smoothly. %s files cached (%s). Gzip: %s | Preload: %s</p></div>',
                number_format($stats['total_files']),
                size_format($stats['total_size']),
                esc_html($gzip_status),
                esc_html($preload_status)
            );
        }
    }

    // ==================== PRELOAD FEATURE ====================

    public function schedule_preload(): void {
        // Clear existing preload hooks to avoid duplicates
        wp_clear_scheduled_hook('serverfreak_run_preload');

        $urls = $this->get_preload_urls();
        if (empty($urls)) return;

        // Schedule first batch immediately
        wp_schedule_single_event(time(), 'serverfreak_run_preload', [array_slice($urls, 0, self::PRELOAD_BATCH)]);
        
        // Schedule remaining batches with delay
        $remaining = array_slice($urls, self::PRELOAD_BATCH);
        $delay = self::PRELOAD_DELAY;
        while (!empty($remaining)) {
            $batch = array_slice($remaining, 0, self::PRELOAD_BATCH);
            $remaining = array_slice($remaining, self::PRELOAD_BATCH);
            wp_schedule_single_event(time() + $delay, 'serverfreak_run_preload', [$batch]);
            $delay += self::PRELOAD_DELAY;
        }
    }

    private function get_preload_urls(): array {
        $urls = [];

        // Homepage
        $urls[] = home_url('/');

        // Recent posts (last 10)
        $recent_posts = get_posts([
            'posts_per_page' => 10,
            'post_status'    => 'publish',
            'post_type'      => 'post',
            'fields'         => 'ids',
        ]);
        foreach ($recent_posts as $post_id) {
            $urls[] = get_permalink($post_id);
        }

        // Key pages
        $key_pages = [
            get_option('page_for_posts'),
            get_option('woocommerce_shop_page_id'),
            get_option('woocommerce_cart_page_id'),
            get_option('woocommerce_checkout_page_id'),
        ];
        foreach ($key_pages as $page_id) {
            if ($page_id && $page_id > 0) {
                $urls[] = get_permalink($page_id);
            }
        }

        // Popular categories
        $categories = get_terms([
            'taxonomy'   => 'category',
            'hide_empty' => true,
            'number'     => 5,
        ]);
        if (!is_wp_error($categories)) {
            foreach ($categories as $cat) {
                $urls[] = get_term_link($cat);
            }
        }

        return array_unique(array_filter($urls));
    }

    public function run_preload_batch(array $urls): void {
        foreach ($urls as $url) {
            $this->preload_url($url);
        }
    }

    private function preload_url(string $url): void {
        $args = [
            'timeout'    => 30,
            'sslverify'  => false,
            'user-agent' => 'Serverfreak-Cache-Preloader/1.0',
            'headers'    => [
                'Accept'           => 'text/html',
                'X-Cache-Preload'  => '1',
            ],
        ];

        if (function_exists('gzencode')) {
            $args['headers']['Accept-Encoding'] = 'gzip';
        }

        wp_remote_get($url, $args);
    }

    // ==================== HTACCESS & REWRITE RULES ====================

    public function maybe_write_htaccess(): void {
        static $done = false;
        if ($done) return;
        $done = true;

        // MU plugin: also handle manual trigger via URL
        if (isset($_GET['sic_rewrite']) && current_user_can('manage_options')) {
            check_admin_referer('sic_rewrite');
            $this->write_htaccess_directly();
            wp_die('Serverfreak Cache: .htaccess rewrite rules updated. <a href="' . esc_url(home_url()) . '">Go home</a>');
        }

        $htaccess_file = ABSPATH . '.htaccess';

        if (!file_exists($htaccess_file)) {
            if (is_writable(ABSPATH)) {
                @file_put_contents($htaccess_file, "# BEGIN WordPress\n# END WordPress\n");
            } else {
                return;
            }
        }

        $content = @file_get_contents($htaccess_file);
        if ($content === false) return;

        if (strpos($content, '# Serverfreak Instant Cache') !== false) return;

        $this->write_htaccess_directly();
    }

    public function write_htaccess_directly(): void {
        $htaccess_file = ABSPATH . '.htaccess';
        $cache_path = str_replace(ABSPATH, '', $this->cache_dir);
        $cache_path = ltrim($cache_path, '/');

        $rules = "\n";
        $rules .= "# Serverfreak Instant Cache\n";
        $rules .= "\n";
        $rules .= "RewriteEngine On\n";
        $rules .= "RewriteCond %{REQUEST_METHOD} GET\n";
        $rules .= "RewriteCond %{QUERY_STRING} ^(utm_source|utm_medium|utm_campaign|utm_term|utm_content|fbclid|gclid)= [NC,OR]\n";
        $rules .= "RewriteCond %{QUERY_STRING} ^$\n";
        $rules .= "RewriteCond %{HTTP_COOKIE} !wordpress_logged_in [NC]\n";
        $rules .= "RewriteCond %{HTTP_COOKIE} !wp_woocommerce_session [NC]\n";
        $rules .= "RewriteCond %{HTTP_COOKIE} !woocommerce_items_in_cart [NC]\n";
        $rules .= "RewriteCond %{HTTP_COOKIE} !woocommerce_cart_hash [NC]\n";
        $rules .= "RewriteCond %{REQUEST_URI} !^/(wp-admin|wp-login|wp-content|wp-includes|cart|checkout|my-account|wc-api|wc-ajax|cartflows|edd-sl|members|groups|forums|topic|reply) [NC]\n";
        
        // GZIP: Check for .html.gz first, fallback to .html
        $rules .= "RewriteCond %{HTTP:Accept-Encoding} gzip\n";
        $rules .= "RewriteCond %{DOCUMENT_ROOT}/" . $cache_path . "%{REQUEST_URI}.html.gz -f\n";
        $rules .= "RewriteRule ^(.*)$ /" . $cache_path . "%{REQUEST_URI}.html.gz [L,E=no-gzip:1]\n";
        $rules .= "\n";
        $rules .= "RewriteCond %{DOCUMENT_ROOT}/" . $cache_path . "%{REQUEST_URI}.html -f\n";
        $rules .= "RewriteRule ^(.*)$ /" . $cache_path . "%{REQUEST_URI}.html [L]\n";
        
        $rules .= "\n";
        $rules .= "# /Serverfreak Instant Cache\n";

        if (file_exists($htaccess_file) && is_writable($htaccess_file)) {
            $content = file_get_contents($htaccess_file);
            $content = preg_replace('/\n# Serverfreak Instant Cache.*?# \/Serverfreak Instant Cache\n/s', '', $content);

            $wp_begin = '# BEGIN WordPress';
            if (strpos($content, $wp_begin) !== false) {
                $content = str_replace($wp_begin, $rules . $wp_begin, $content);
            } else {
                $content = $rules . $content;
            }

            @file_put_contents($htaccess_file, $content, LOCK_EX);
        }
    }

    public function remove_htaccess_rules(): void {
        $htaccess_file = ABSPATH . '.htaccess';
        if (!file_exists($htaccess_file)) return;

        $content = @file_get_contents($htaccess_file);
        if ($content === false) return;

        $content = preg_replace('/\n# Serverfreak Instant Cache.*?# \/Serverfreak Instant Cache\n/s', '', $content);
        @file_put_contents($htaccess_file, $content, LOCK_EX);
    }

    public function add_rewrite_rules(string $rules): string {
        if (strpos($rules, '# Serverfreak Instant Cache') !== false) return $rules;

        $cache_path = str_replace(ABSPATH, '', $this->cache_dir);
        $cache_path = ltrim($cache_path, '/');

        $new_rules = "\n";
        $new_rules .= "# Serverfreak Instant Cache\n";
        $new_rules .= "RewriteCond %{REQUEST_METHOD} GET\n";
        $new_rules .= "RewriteCond %{QUERY_STRING} ^(utm_source|utm_medium|utm_campaign|utm_term|utm_content|fbclid|gclid)= [NC,OR]\n";
        $new_rules .= "RewriteCond %{QUERY_STRING} ^$\n";
        $new_rules .= "RewriteCond %{HTTP_COOKIE} !wordpress_logged_in [NC]\n";
        $new_rules .= "RewriteCond %{HTTP_COOKIE} !wp_woocommerce_session [NC]\n";
        $new_rules .= "RewriteCond %{HTTP_COOKIE} !woocommerce_items_in_cart [NC]\n";
        $new_rules .= "RewriteCond %{HTTP_COOKIE} !woocommerce_cart_hash [NC]\n";
        $new_rules .= "RewriteCond %{REQUEST_URI} !^/(wp-admin|wp-login|wp-content|wp-includes|cart|checkout|my-account|wc-api|wc-ajax|cartflows|edd-sl|members|groups|forums|topic|reply) [NC]\n";
        
        // GZIP: Check for .html.gz first, fallback to .html
        $new_rules .= "RewriteCond %{HTTP:Accept-Encoding} gzip\n";
        $new_rules .= "RewriteCond %{DOCUMENT_ROOT}/" . $cache_path . "%{REQUEST_URI}.html.gz -f\n";
        $new_rules .= "RewriteRule ^(.*)$ /" . $cache_path . "%{REQUEST_URI}.html.gz [L,E=no-gzip:1]\n";
        $new_rules .= "\n";
        $new_rules .= "RewriteCond %{DOCUMENT_ROOT}/" . $cache_path . "%{REQUEST_URI}.html -f\n";
        $new_rules .= "RewriteRule ^(.*)$ /" . $cache_path . "%{REQUEST_URI}.html [L]\n";
        
        $new_rules .= "# /Serverfreak Instant Cache\n";

        return $new_rules . $rules;
    }

    // ==================== CACHE SERVING (WITH GZIP) ====================

    public function late_init(): void {
        if ($this->should_skip_logged_in()) {
            $this->skip = true;
            $this->send_bypass_header();
            return;
        }

        $this->build_dynamic_page_list();

        if ($this->should_skip_dynamic_pages()) {
            $this->skip = true;
            $this->send_bypass_header();
            return;
        }

        add_action('template_redirect', [$this, 'try_serve_cache'], 1);
        add_action('template_redirect', [$this, 'start_capture'], 99999);
    }

    private function should_skip_logged_in(): bool {
        if ($this->skip) return true;
        if (is_customize_preview()) return true;
        if (post_password_required()) return true;
        if (apply_filters('serverfreak_cache_skip_logged_in', is_user_logged_in())) return true;
        if (is_feed()) return true;
        return false;
    }

    private function build_dynamic_page_list(): void {
        if ($this->dynamic_pages_built) return;

        $this->dynamic_page_ids = [];
        $this->dynamic_patterns = [];

        if (function_exists('WC') || class_exists('WooCommerce')) {
            $wc_pages = [
                'woocommerce_cart_page_id',
                'woocommerce_checkout_page_id',
                'woocommerce_myaccount_page_id',
                'woocommerce_terms_page_id',
            ];
            foreach ($wc_pages as $option) {
                $page_id = (int) get_option($option, 0);
                if ($page_id > 0) $this->dynamic_page_ids[] = $page_id;
            }
            $this->dynamic_patterns[] = '/wc-api/';
            $this->dynamic_patterns[] = '/wc-ajax/';
        }

        if (function_exists('cartflows') || class_exists('Cartflows_Loader') || class_exists('Cartflows_Admin')) {
            if (function_exists('cartflows_get_global_checkout_id')) {
                $global = (int) cartflows_get_global_checkout_id();
                if ($global > 0) $this->dynamic_page_ids[] = $global;
            }
            $cf_posts = get_posts([
                'post_type' => ['cartflows_flow', 'cartflows_step', 'cartflows_checkout', 'cartflows_thankyou', 'cartflows_upsell', 'cartflows_downsell'],
                'post_status' => 'publish',
                'posts_per_page' => -1,
                'fields' => 'ids',
                'suppress_filters' => false,
            ]);
            if (!empty($cf_posts) && !is_wp_error($cf_posts)) {
                foreach ($cf_posts as $post_id) $this->dynamic_page_ids[] = (int) $post_id;
            }
            $this->dynamic_patterns[] = '/cartflows';
            $this->dynamic_patterns[] = 'wcf-step=';
            $this->dynamic_patterns[] = 'cartflows_step=';
            $this->dynamic_patterns[] = 'wcf-';
        }

        if (class_exists('Easy_Digital_Downloads')) {
            $this->dynamic_patterns[] = '/edd-sl/';
            $this->dynamic_patterns[] = 'edd_action=';
        }
        if (class_exists('MeprUser')) {
            $this->dynamic_patterns[] = '/account/';
            $this->dynamic_patterns[] = '/login/';
        }
        if (class_exists('SFWD_LMS') || class_exists('LifterLMS')) {
            $this->dynamic_patterns[] = '/courses/';
            $this->dynamic_patterns[] = '/lesson/';
        }
        if (function_exists('bp_core_get_directory_pages')) {
            $bp_pages = bp_core_get_directory_pages();
            if (!empty($bp_pages)) {
                foreach ($bp_pages as $component => $page) {
                    if (!empty($page->id)) $this->dynamic_page_ids[] = (int) $page->id;
                }
            }
            $this->dynamic_patterns[] = '/members/';
            $this->dynamic_patterns[] = '/groups/';
        }
        if (class_exists('bbPress')) {
            $this->dynamic_patterns[] = '/forums/';
            $this->dynamic_patterns[] = '/topic/';
            $this->dynamic_patterns[] = '/reply/';
        }

        $this->dynamic_page_ids = array_unique(array_map('intval', apply_filters('serverfreak_cache_dynamic_page_ids', $this->dynamic_page_ids)));
        $this->dynamic_patterns = array_unique(apply_filters('serverfreak_cache_dynamic_patterns', $this->dynamic_patterns));
        $this->dynamic_pages_built = true;
    }

    private function should_skip_dynamic_pages(): bool {
        $uri = $_SERVER['REQUEST_URI'] ?? '/';

        $safe_params = [
            'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content',
            'fbclid', 'gclid', 'dclid', 'twclid', 'li_fat_id',
            'wbraid', 'gbraid', 'srsltid', 'irclickid', 'mc_cid', 'mc_eid',
        ];

        if (!empty($_GET)) {
            $keys = array_keys($_GET);
            $unsafe = array_diff($keys, $safe_params);
            $pagination_params = ['paged', 'page', 'product-page', 'cpage'];
            $unsafe = array_diff($unsafe, $pagination_params);
            if (!empty($unsafe)) return true;
        }

        $wc_cookies = [
            'woocommerce_items_in_cart',
            'woocommerce_cart_hash',
            'wp_woocommerce_session_',
            'woocommerce_recently_viewed',
        ];
        foreach ($wc_cookies as $cookie_name) {
            if (!empty($_COOKIE)) {
                foreach ($_COOKIE as $key => $value) {
                    if (stripos($key, $cookie_name) !== false) return true;
                }
            }
        }

        if (isset($_SERVER['HTTP_REFERER']) && stripos($_SERVER['HTTP_REFERER'], 'wc-ajax') !== false) return true;

        $current_id = get_queried_object_id();
        if ($current_id > 0 && in_array($current_id, $this->dynamic_page_ids, true)) return true;

        global $post;
        if ($post instanceof WP_Post && in_array((int) $post->ID, $this->dynamic_page_ids, true)) return true;

        foreach ($this->dynamic_patterns as $pattern) {
            if (stripos($uri, $pattern) !== false) return true;
        }

        if (function_exists('is_cart') && is_cart()) return true;
        if (function_exists('is_checkout') && is_checkout()) return true;
        if (function_exists('is_account_page') && is_account_page()) return true;
        if (function_exists('is_wc_endpoint_url') && is_wc_endpoint_url()) return true;
        if (function_exists('wcf_get_page_id') && wcf_get_page_id()) return true;
        if (function_exists('wc') && WC() && WC()->session) {
            $notices = WC()->session->get('wc_notices', []);
            if (!empty($notices)) return true;
        }
        if (function_exists('edd_get_cart_contents') && !empty(edd_get_cart_contents())) return true;
        if (is_author()) return true;
        if (is_search()) return true;
        if (is_404()) $this->ttl = (int) apply_filters('serverfreak_cache_404_ttl', 60);

        return (bool) apply_filters('serverfreak_cache_should_skip', false, $uri, $this);
    }

    private function get_cache_key(): string {
        if (null !== $this->cache_key) return $this->cache_key;

        $uri = $_SERVER['REQUEST_URI'] ?? '/';
        $safe_params = [
            'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content',
            'fbclid', 'gclid', 'dclid', 'twclid', 'li_fat_id',
        ];
        $uri = remove_query_arg($safe_params, $uri);

        $device = '';
        if (apply_filters('serverfreak_cache_separate_mobile', false)) {
            $device = wp_is_mobile() ? '_mobile' : '_desktop';
        }

        $scheme = is_ssl() ? 'https' : 'http';
        $variant = '';
        if (isset($_SERVER['HTTP_ACCEPT']) && stripos($_SERVER['HTTP_ACCEPT'], 'image/webp') !== false) {
            $variant .= '_webp';
        }

        $this->cache_key = md5($scheme . '://' . ($_SERVER['HTTP_HOST'] ?? '') . $uri . $device . $variant);
        return $this->cache_key;
    }

    private function get_cache_file(): string {
        return $this->cache_dir . $this->get_cache_key() . '.html';
    }

    private function get_cache_gzip_file(): string {
        return $this->cache_dir . $this->get_cache_key() . '.html.gz';
    }

    private function get_cache_meta(): string {
        return $this->cache_dir . $this->get_cache_key() . '.json';
    }

    private function get_cache_footer(int $cache_time, bool $is_hit): string {
        if (!apply_filters('serverfreak_cache_show_footer', true)) return '';

        $age = human_time_diff($cache_time, time());
        $ttl_remaining = human_time_diff(time(), $cache_time + $this->ttl);
        $storage = wp_using_ext_object_cache() ? 'Object+Filesystem' : 'Filesystem';
        $gzip = function_exists('gzencode') ? 'Gzip' : 'Plain';

        return sprintf(
            "\n<!-- Cached by Serverfreak Instant Cache | Age: %s | TTL Left: %s | Storage: %s | Compression: %s -->",
            $age,
            $ttl_remaining,
            $storage,
            $gzip
        );
    }

    /**
     * Serve cached file - with Gzip support
     */
    public function try_serve_cache(): void {
        if ($this->skip) return;

        $cache_file = $this->get_cache_file();
        $gzip_file = $this->get_cache_gzip_file();
        $use_gzip = false;
        $serve_file = $cache_file;

        // Check if browser accepts gzip
        $accepts_gzip = isset($_SERVER['HTTP_ACCEPT_ENCODING']) && stripos($_SERVER['HTTP_ACCEPT_ENCODING'], 'gzip') !== false;

        // Prefer .html.gz if browser supports it and file exists
        if ($accepts_gzip && file_exists($gzip_file)) {
            $serve_file = $gzip_file;
            $use_gzip = true;
        } elseif (!file_exists($cache_file)) {
            return;
        }

        $age = time() - filemtime($serve_file);
        if ($age > $this->ttl) {
            unlink($serve_file);
            @unlink($use_gzip ? $cache_file : $gzip_file);
            @unlink($this->get_cache_meta());
            return;
        }

        $file_size = filesize($serve_file);
        if (false === $file_size || $file_size > self::MAX_FILE_SIZE) {
            unlink($serve_file);
            @unlink($use_gzip ? $cache_file : $gzip_file);
            @unlink($this->get_cache_meta());
            return;
        }

        // Set headers
        header(self::HEADER_HIT . ': HIT');
        header(self::HEADER_GZIP . ': ' . ($use_gzip ? 'YES' : 'NO'));
        header('Age: ' . $age);
        header('Cache-Control: public, max-age=' . max(0, $this->ttl - $age));
        header('Expires: ' . gmdate('D, d M Y H:i:s T', time() + max(0, $this->ttl - $age)));

        if ($use_gzip) {
            header('Content-Encoding: gzip');
            header('Vary: Accept-Encoding');
        }

        readfile($serve_file);
        echo "\n";
        exit;
    }

    public function start_capture(): void {
        if ($this->skip) return;
        ob_start([$this, 'save_cache']);
    }

    /**
     * Save cache - with optional Gzip compression
     */
    public function save_cache(string $content): string {
        if ($this->skip || empty($content)) return $content;
        if (http_response_code() !== 200) return $content;

        if (stripos($content, '<form') !== false) return $content;
        if (stripos($content, 'wc_fragments') !== false || stripos($content, 'woocommerce-cart-fragment') !== false) return $content;
        if (stripos($content, 'cartflows') !== false || stripos($content, 'wcf-') !== false || stripos($content, 'data-cartflows') !== false) return $content;
        if (stripos($content, 'edd-cart') !== false) return $content;
        if (stripos($content, 'wpadminbar') !== false || stripos($content, 'admin-bar') !== false) return $content;
        if (strpos($content, '_wpnonce') !== false) return $content;

        $cache_file = $this->get_cache_file();
        $gzip_file = $this->get_cache_gzip_file();
        $meta_file = $this->get_cache_meta();
        $cache_time = time();

        $content_with_footer = $content . $this->get_cache_footer($cache_time, false);

        $meta = [
            'time' => $cache_time,
            'uri' => $_SERVER['REQUEST_URI'] ?? '/',
            'size' => strlen($content_with_footer),
            'gzip' => false,
        ];

        // Save plain HTML
        @file_put_contents($meta_file, json_encode($meta), LOCK_EX);
        @file_put_contents($cache_file, $content_with_footer, LOCK_EX);

        // GZIP: Also save compressed version if zlib available
        if (function_exists('gzencode')) {
            $gzipped = gzencode($content_with_footer, 9);
            if ($gzipped !== false) {
                @file_put_contents($gzip_file, $gzipped, LOCK_EX);
                $meta['gzip'] = true;
                $meta['gzip_size'] = strlen($gzipped);
                @file_put_contents($meta_file, json_encode($meta), LOCK_EX);
            }
        }

        header(self::HEADER_HIT . ': MISS');
        header('Cache-Control: public, max-age=' . $this->ttl);
        header('Expires: ' . gmdate('D, d M Y H:i:s T', time() + $this->ttl));

        return $content_with_footer;
    }

    private function send_bypass_header(): void {
        if (!headers_sent()) header(self::HEADER_HIT . ': BYPASS');
    }

    private function delete_cache_files(): void {
        @unlink($this->get_cache_file());
        @unlink($this->get_cache_gzip_file());
        @unlink($this->get_cache_meta());
    }

    public function clear_all_cache(): void {
        if (!is_dir($this->cache_dir)) return;

        $iterator = new DirectoryIterator($this->cache_dir);
        foreach ($iterator as $file) {
            if ($file->isFile() && !$file->isDot()) {
                $ext = $file->getExtension();
                if (in_array($ext, ['html', 'gz', 'json', 'lock', 'tmp'], true)) {
                    @unlink($file->getPathname());
                }
            }
        }

        // Trigger preload after clearing
        do_action('serverfreak_cache_cleared');
    }

    public function clear_url_cache(string $url): void {
        $parsed = parse_url($url);
        $path = $parsed['path'] ?? '/';
        if (!empty($parsed['query'])) $path .= '?' . $parsed['query'];

        $key = md5((is_ssl() ? 'https' : 'http') . '://' . ($_SERVER['HTTP_HOST'] ?? '') . $path);

        @unlink($this->cache_dir . $key . '.html');
        @unlink($this->cache_dir . $key . '.html.gz');
        @unlink($this->cache_dir . $key . '.json');
    }

    public function handle_post_save(int $post_id, WP_Post $post, bool $update): void {
        if (wp_is_post_revision($post_id)) return;

        $this->clear_url_cache(get_permalink($post_id));
        $this->clear_url_cache(home_url('/'));

        if ($post->post_type === 'post') {
            $this->clear_url_cache(get_permalink(get_option('page_for_posts', 0)) ?: home_url('/'));
        }

        $taxonomies = get_object_taxonomies($post->post_type);
        foreach ($taxonomies as $taxonomy) {
            $terms = get_the_terms($post_id, $taxonomy);
            if (!empty($terms) && !is_wp_error($terms)) {
                foreach ($terms as $term) $this->clear_url_cache(get_term_link($term));
            }
        }
    }

    public function handle_post_trash(int $post_id): void {
        $this->clear_url_cache(get_permalink($post_id));
        $this->clear_all_cache();
    }

    public function handle_blog_delete(int $blog_id): void {
        $site_dir = WP_CONTENT_DIR . '/cache/serverfreak-cache/site-' . $blog_id . '/';
        if (is_dir($site_dir)) {
            $iterator = new RecursiveIteratorIterator(
                new RecursiveDirectoryIterator($site_dir, RecursiveDirectoryIterator::SKIP_DOTS),
                RecursiveIteratorIterator::CHILD_FIRST
            );
            foreach ($iterator as $file) {
                if ($file->isDir()) @rmdir($file->getPathname());
                else @unlink($file->getPathname());
            }
            @rmdir($site_dir);
        }
    }

    public function register_cli_commands(): void {
        if (!class_exists('WP_CLI')) return;
        WP_CLI::add_command('serverfreak-cache', Serverfreak_Cache_CLI::class);
    }

    public function get_stats(): array {
        $stats = [
            'total_files' => 0,
            'total_size' => 0,
            'gzip_files' => 0,
            'gzip_size' => 0,
            'oldest_cache' => null,
            'newest_cache' => null,
            'cache_dir' => $this->cache_dir,
            'ttl' => $this->ttl,
            'dynamic_pages' => count($this->dynamic_page_ids),
            'dynamic_patterns' => count($this->dynamic_patterns),
        ];

        if (!is_dir($this->cache_dir)) return $stats;

        $iterator = new DirectoryIterator($this->cache_dir);
        foreach ($iterator as $file) {
            if ($file->isFile()) {
                $ext = $file->getExtension();
                if ($ext === 'html') {
                    $stats['total_files']++;
                    $stats['total_size'] += $file->getSize();
                    $mtime = $file->getMTime();
                } elseif ($ext === 'gz') {
                    $stats['gzip_files']++;
                    $stats['gzip_size'] += $file->getSize();
                    $mtime = $file->getMTime();
                } else {
                    continue;
                }

                if (in_array($ext, ['html', 'gz'])) {
                    if (null === $stats['oldest_cache'] || $mtime < $stats['oldest_cache']) {
                        $stats['oldest_cache'] = $mtime;
                    }
                    if (null === $stats['newest_cache'] || $mtime > $stats['newest_cache']) {
                        $stats['newest_cache'] = $mtime;
                    }
                }
            }
        }

        return $stats;
    }
}

/**
 * WP-CLI Commands
 */
class Serverfreak_Cache_CLI {

    public function clear($args, $assoc_args): void {
        $engine = Serverfreak_Instant_Cache::instance();
        if (!empty($assoc_args['url'])) {
            $engine->clear_url_cache($assoc_args['url']);
            WP_CLI::success('Cache cleared for: ' . $assoc_args['url']);
        } else {
            $engine->clear_all_cache();
            WP_CLI::success('All cache cleared.');
        }
    }

    public function stats(): void {
        $engine = Serverfreak_Instant_Cache::instance();
        $stats = $engine->get_stats();

        WP_CLI::line('Cache Directory: ' . $stats['cache_dir']);
        WP_CLI::line('Total Files: ' . number_format($stats['total_files']));
        WP_CLI::line('Total Size: ' . size_format($stats['total_size']));
        WP_CLI::line('Gzip Files: ' . number_format($stats['gzip_files']));
        WP_CLI::line('Gzip Size: ' . size_format($stats['gzip_size']));
        WP_CLI::line('TTL: ' . $stats['ttl'] . ' seconds');
        WP_CLI::line('Dynamic Pages: ' . $stats['dynamic_pages']);
        WP_CLI::line('Dynamic Patterns: ' . $stats['dynamic_patterns']);

        if ($stats['oldest_cache']) {
            WP_CLI::line('Oldest Cache: ' . human_time_diff($stats['oldest_cache'], time()) . ' ago');
        }
        if ($stats['newest_cache']) {
            WP_CLI::line('Newest Cache: ' . human_time_diff($stats['newest_cache'], time()) . ' ago');
        }
    }

    public function test($args): void {
        $url = $args[0];
        $response = wp_remote_get($url, [
            'headers' => ['Accept' => 'text/html'],
            'timeout' => 30,
        ]);

        if (is_wp_error($response)) {
            WP_CLI::error($response->get_error_message());
        }

        $headers = wp_remote_retrieve_headers($response);
        $status = wp_remote_retrieve_response_code($response);

        WP_CLI::line('Status: ' . $status);
        WP_CLI::line('X-Cache-Status: ' . ($headers['x-cache-status'] ?? 'Not set'));
        WP_CLI::line('X-Cache-Gzip: ' . ($headers['x-cache-gzip'] ?? 'Not set'));
        WP_CLI::line('Content-Type: ' . ($headers['content-type'] ?? 'Not set'));
    }

    public function preload(): void {
        $engine = Serverfreak_Instant_Cache::instance();
        $engine->schedule_preload();
        WP_CLI::success('Cache preload scheduled.');
    }
}

