#!/bin/bash

# Ensure script is run as root
if [[ $EUID -ne 0 ]]; then
   echo "This script must be run as root" 
   exit 1
fi

echo "Starting BotStopper installation..."

# 1. Create botstopper-upstream.conf
cat << 'EOF' > /etc/nginx/conf.d/botstopper-upstream.conf
upstream botstopper {
    hash $remote_addr consistent;
    server 103.27.72.252:8923 max_fails=1 fail_timeout=2s;
    server 185.93.166.3:8923  max_fails=1 fail_timeout=2s;
    keepalive 32;
}

# Whitelist specific IP addresses:|Zetpy|Doku|
map $remote_addr $ip_whitelisted {
    default 0;
    18.136.44.161 1;
    52.76.220.71   1;
    18.136.75.246  1;
    121.123.49.98  1;
    147.139.129.160 1;
    149.129.217.17 1;
    149.129.219.140 1;
    47.254.248.197 1;
    47.250.12.92 1;

}

# Bypass BotStopper on cPanel service subdomains OR whitelisted IPs
map $host $botstopper_bypass_host {
    default 0;
    "~*^(?:cpanel|whm|webmail|webdisk|cpcalendars|cpcontacts|autodiscover|autoconfig)\." 1;
}



# Bypass BotStopper for any URI path containing "doku"
map $request_uri $botstopper_bypass_uri {
    default 0;
    "~*doku" 1;
}

# Bypass BotStopper for trusted crawler ecosystems (Meta + Google)
# NOTE: UA-only match, no IP verification — spoofable. Googlebot especially.
map $http_user_agent $botstopper_bypass_ua {
    default 0;
    "~*(facebookexternalhit|facebookcatalog|Meta-ExternalAgent|Meta-ExternalFetcher|Instagram|WhatsApp|Messenger|MetaTrademark|Meta-Commerce-Platform|Meta-Verification)" 1;
    "~*(AdsBot-Google|Google-Adwords-Instant|Googlebot|Googlebot-Image|Googlebot-News|Googlebot-Video|Google-InspectionTool|Storebot-Google|Mediapartners-Google|Google-Safety|Google-Read-Aloud|GoogleProducer|GoogleSites|GoogleOther|GoogleOther-Image|GoogleImageProxy|GoogleOther-Video|FeedFetcher-Google)" 1;
}


# Combine host bypass and IP whitelist into a single condition
map "$botstopper_bypass_host:$ip_whitelisted:$botstopper_bypass_ua:$botstopper_bypass_uri" $botstopper_bypass  {
    default 0;
    "~1" 1;  # If either host match OR IP match is 1, bypass set to 1
}

EOF
echo "✅ Created /etc/nginx/conf.d/botstopper-upstream.conf"

# 2. Ensure server-includes directory exists and create botstopper.conf
mkdir -p /etc/nginx/conf.d/server-includes
cat << 'EOF' > /etc/nginx/conf.d/server-includes/botstopper.conf
location ^~ /.within.website/ {
    auth_request off;
    proxy_pass http://botstopper;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
 
location ^~ /.well-known/acme-challenge/ {
    auth_request off;
    include conf.d/includes-optional/cpanel-proxy.conf;
}
location ^~ /.well-known/pki-validation/ {
    auth_request off;
    include conf.d/includes-optional/cpanel-proxy.conf;
}
 
location = /.botstopper-check {
    internal;
    auth_request off;
    if ($botstopper_bypass) { return 200; }
    proxy_pass http://botstopper/.within.website/x/cmd/anubis/api/check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Uri $request_uri;
 
    # --- fast failover ---
    proxy_connect_timeout 1s;          # don't wait 60s to notice a dead node
    proxy_read_timeout 5s;
    proxy_send_timeout 2s;
    proxy_next_upstream error timeout http_502 http_503 http_504 http_403;
    proxy_next_upstream_tries 2;       # try the other instance, then give up
    proxy_next_upstream_timeout 3s;    # cap total retry window
}
 
location @redirectToBotStopper {
    auth_request off;
    return 307 https://$host/.within.website/?redir=https://$host$request_uri;
}
 
location @botstopper_failopen {
    auth_request off;
    include conf.d/includes-optional/cpanel-proxy.conf;
}
 
auth_request /.botstopper-check;
error_page 401 = @redirectToBotStopper;
error_page 500 502 504 = @botstopper_failopen;
EOF
echo "✅ Created /etc/nginx/conf.d/server-includes/botstopper.conf"

# 3. Open TCP_OUT port 8923 in CSF
if [ -f /etc/csf/csf.conf ]; then
    echo "⚙️ Configuring CSF to open TCP_OUT port 8923..."
    # Check if 8923 is already present in TCP_OUT
    if ! grep -qE '^TCP_OUT =.*(^|,)8923(,|$)' /etc/csf/csf.conf; then
        sed -i 's/^TCP_OUT = "\(.*\)"/TCP_OUT = "\1,8923"/' /etc/csf/csf.conf
        csf -ra > /dev/null 2>&1
        echo "✅ CSF configured and restarted."
    else
        echo "✅ Port 8923 is already open in CSF."
    fi
else
    echo "⚠️ CSF configuration not found. Please ensure port 8923 is open manually."
fi

# 4. Test and reload Nginx
echo "⚙️ Testing Nginx configuration..."
if nginx -t; then
    echo "⚙️ Reloading Nginx..."
    systemctl reload nginx
    echo "🎉 BotStopper installation successful!"
else
    echo "❌ Nginx test failed. Please check the syntax errors. Reload aborted."
    exit 1
fi

# 5. Run connection tests
echo "----------------------------------------"
echo "Running connectivity tests..."
for ip in 103.27.72.252 185.93.166.3; do
  echo -n "$ip: "
  curl -s -o /dev/null -w '%{http_code}\n' --max-time 3 \
    -H 'X-Real-IP: 203.0.113.10' -H 'X-Forwarded-Proto: https' \
    -A 'Mozilla/5.0 Chrome/130.0' \
    http://$ip:8923/.within.website/x/cmd/anubis/api/check
done
echo "ℹ️  (Note: Both must return '401'. If it times out or returns '000', CSF TCP_OUT was not opened properly.)"
echo "----------------------------------------"
