#!/bin/bash

# Ensure script is run as root
if [[ $EUID -ne 0 ]]; then
   echo "This script must be run as root" 
   exit 1
fi

echo "Starting BotStopper uninstallation..."

# 1. Remove configuration files
rm -f /etc/nginx/conf.d/botstopper-upstream.conf
rm -f /etc/nginx/conf.d/server-includes/botstopper.conf
echo "✅ Removed Nginx configuration files."

# 2. Test and reload Nginx
echo "⚙️ Testing Nginx configuration..."
if nginx -t; then
    echo "⚙️ Reloading Nginx..."
    systemctl reload nginx
    echo "🎉 BotStopper uninstallation complete!"
else
    echo "❌ Nginx test failed after removing files. Reload aborted."
    exit 1
fi
