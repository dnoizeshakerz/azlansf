install_cpanel_apache() {
    local conf_file="/etc/apache2/conf.d/includes/pre_virtualhost_global.conf"
    local backup_file="${conf_file}.$(date +%Y%m%d-%H%M%S).bak"

    echo -e "${YELLOW}[INFO] Installing for cPanel + Apache...${NC}"
    mkdir -p "$(dirname "$conf_file")"
    touch "$conf_file"

    if grep -q "$MARKER_START" "$conf_file"; then
        echo -e "${YELLOW}[WARN] 8G Firewall already installed in $conf_file${NC}"
        return 0
    fi

    backup_file "$conf_file" "$backup_file"

    {
        echo ""
        echo "$MARKER_START"
        echo "# 8G Firewall v1.5 - cPanel + Apache"
        echo "# $(date +%Y-%m-%d\ %H:%M:%S)"
        apache_setenvif
        apache_access_control
        echo "RewriteEngine On"
        echo "RewriteOptions InheritDown"
        rewrite_rules
        echo "$MARKER_END"
    } >> "$conf_file"

    echo -e "${GREEN}[OK] Rules appended to $conf_file${NC}"

    echo -e "${YELLOW}[INFO] Testing Apache configuration...${NC}"
    if apachectl configtest 2>&1; then
        echo -e "${GREEN}[OK] Apache config test passed${NC}"
    else
        echo -e "${RED}[FAIL] Apache config test failed. Restoring backup...${NC}"
        cp -a "$backup_file" "$conf_file"
        exit 1
    fi

    echo -e "${YELLOW}[INFO] Rebuilding httpd configuration...${NC}"
    /scripts/rebuildhttpdconf

    echo -e "${YELLOW}[INFO] Restarting Apache...${NC}"
    /scripts/restartsrv_httpd

    echo -e "${GREEN}[OK] 8G Firewall installed for cPanel + Apache${NC}"
}

