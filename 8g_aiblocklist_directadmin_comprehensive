nginx_server_rules() {
    cat <<'NGINX_SERVER_EOF'
# 8G Firewall - Server Context Rules
# Include this file inside every server block, or use a global server include

if ($g8_bad_ua)      { return 403; }
if ($g8_bad_referer) { return 403; }
if ($g8_bad_method)  { return 403; }
if ($g8_bad_cookie)  { return 403; }
if ($g8_bad_uri)     { return 403; }
if ($g8_bad_query)   { return 403; }

# Block xmlrpc and trackback
location ~* ^/(xmlrpc|wp-trackback)\.php {
    return 403;
}
NGINX_SERVER_EOF
}

