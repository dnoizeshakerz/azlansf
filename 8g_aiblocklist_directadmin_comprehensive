install_cpanel_nginx() {
    local maps_file="/etc/nginx/conf.d/8g-firewall-maps.conf"
    local server_file="/etc/nginx/conf.d/8g-firewall-server.conf"
    local nginx_conf="/etc/nginx/nginx.conf"
    local backup_maps="${maps_file}.$(date +%Y%m%d-%H%M%S).bak"
    local backup_server="${server_file}.$(date +%Y%m%d-%H%M%S).bak"

    echo -e "${YELLOW}[INFO] Installing for cPanel + ea-nginx...${NC}"

    if [[ -f "$maps_file" ]]; then
        backup_file "$maps_file" "$backup_maps"
    fi
    if [[ -f "$server_file" ]]; then
        backup_file "$server_file" "$backup_server"
    fi

    nginx_maps > "$maps_file"
    nginx_server_rules > "$server_file"

    echo -e "${GREEN}[OK] Nginx map config: $maps_file${NC}"
    echo -e "${GREEN}[OK] Nginx server config: $server_file${NC}"

    # Try to auto-include in cPanel nginx template or existing configs
    local template_dir="/var/cpanel/templates/nginx"
    local included=0

    if [[ -d "$template_dir" ]]; then
        for tmpl in "$template_dir"/*.tmpl "$template_dir"/vhost/*.tmpl "$template_dir"/vhost.local/*.tmpl 2>/dev/null; do
            [[ -f "$tmpl" ]] || continue
            if ! grep -q "8g-firewall-server.conf" "$tmpl" 2>/dev/null; then
                # Add include near the top of server block
                if grep -q "server\s*{" "$tmpl" 2>/dev/null; then
                    sed -i '/server\s*{/a\    include /etc/nginx/conf.d/8g-firewall-server.conf;' "$tmpl"
                    echo -e "${GREEN}[OK] Added include to template: $tmpl${NC}"
                    included=1
                fi
            fi
        done
    fi

    # Also try to add to existing generated configs as a temporary measure
    if [[ -d /etc/nginx/conf.d/users ]]; then
        for user_conf in /etc/nginx/conf.d/users/*.conf; do
            [[ -f "$user_conf" ]] || continue
            if ! grep -q "8g-firewall-server.conf" "$user_conf" 2>/dev/null; then
                sed -i '/server\s*{/a\    include /etc/nginx/conf.d/8g-firewall-server.conf;' "$user_conf"
            fi
        done
    fi

    echo -e "${YELLOW}[INFO] Testing nginx configuration...${NC}"
    if nginx -t 2>&1; then
        echo -e "${GREEN}[OK] Nginx config test passed${NC}"
    else
        echo -e "${RED}[FAIL] Nginx config test failed. Check syntax and restore backups if needed.${NC}"
        echo -e "${YELLOW}Backups: $backup_maps, $backup_server${NC}"
        exit 1
    fi

    echo -e "${YELLOW}[INFO] Reloading nginx...${NC}"
    if /scripts/restartsrv_nginx 2>/dev/null; then
        echo -e "${GREEN}[OK] Nginx reloaded${NC}"
    elif systemctl reload nginx 2>/dev/null; then
        echo -e "${GREEN}[OK] Nginx reloaded via systemctl${NC}"
    elif service nginx reload 2>/dev/null; then
        echo -e "${GREEN}[OK] Nginx reloaded via service${NC}"
    else
        echo -e "${YELLOW}[WARN] Could not reload nginx automatically${NC}"
    fi

    echo -e "${GREEN}[OK] 8G Firewall installed for cPanel + nginx${NC}"
    if [[ "$included" -eq 0 ]]; then
        echo -e "${YELLOW}[NOTE] Could not auto-detect cPanel nginx template.${NC}"
        echo -e "${YELLOW}       Add this line inside each server block:${NC}"
        echo -e "${YELLOW}       include /etc/nginx/conf.d/8g-firewall-server.conf;${NC}"
    fi
}

