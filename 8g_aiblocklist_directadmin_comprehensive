    local custom_conf=""

    echo -e "${YELLOW}[INFO] Installing for DirectAdmin + Apache...${NC}"

    if [[ -f /usr/local/apache/bin/httpd ]]; then
        apache_bin="/usr/local/apache/bin/httpd"
        apache_conf="/usr/local/apache/conf/httpd.conf"
        apache_extra="/usr/local/apache/conf/extra"
        custom_conf="/usr/local/apache/conf/extra/8g-firewall.conf"
    elif [[ -f /usr/sbin/httpd ]]; then
        apache_bin="/usr/sbin/httpd"
        apache_conf="/etc/httpd/conf/httpd.conf"
        apache_extra="/etc/httpd/conf/extra"
        custom_conf="/etc/httpd/conf/extra/8g-firewall.conf"
    elif [[ -f /usr/local/apache2/bin/httpd ]]; then
        apache_bin="/usr/local/apache2/bin/httpd"
        apache_conf="/usr/local/apache2/conf/httpd.conf"
        apache_extra="/usr/local/apache2/conf/extra"
        custom_conf="/usr/local/apache2/conf/extra/8g-firewall.conf"
    else
        echo -e "${RED}Error: Apache binary not found${NC}"
        exit 1
    fi

    if [[ ! -f "$apache_conf" ]]; then
        echo -e "${RED}Error: Apache config not found at $apache_conf${NC}"
        exit 1
    fi

    mkdir -p "$apache_extra"

    if [[ -f "$custom_conf" ]]; then
        echo -e "${YELLOW}[WARN] 8G Firewall config already exists at $custom_conf${NC}"
        return 0
    fi

    backup_file "$apache_conf" "$BACKUP_DIR/httpd.conf.$(date +%Y%m%d-%H%M%S).bak"

    {
        echo "$MARKER_START"
        echo "# 8G Firewall v1.5 - DirectAdmin + Apache"
        echo "# $(date +%Y-%m-%d\ %H:%M:%S)"
        apache_setenvif
        apache_access_control
        echo "RewriteEngine On"
        echo "RewriteOptions InheritDown"
        rewrite_rules
        echo "$MARKER_END"
    } > "$custom_conf"

    # Add Include to httpd.conf if not present
    if ! grep -q "8g-firewall.conf" "$apache_conf" 2>/dev/null; then
        echo "" >> "$apache_conf"
        echo "# 8G Firewall Global Include" >> "$apache_conf"
        echo "Include $custom_conf" >> "$apache_conf"
        echo -e "${GREEN}[OK] Added Include to $apache_conf${NC}"
    fi

    echo -e "${YELLOW}[INFO] Testing Apache configuration...${NC}"
    if $apache_bin -t 2>&1; then
        echo -e "${GREEN}[OK] Apache config test passed${NC}"
    else
        echo -e "${RED}[FAIL] Apache config test failed. Restoring...${NC}"
        sed -i "/8g-firewall.conf/d" "$apache_conf"
        rm -f "$custom_conf"
        exit 1
    fi

    echo -e "${YELLOW}[INFO] Rebuilding DirectAdmin configs...${NC}"
    cd /usr/local/directadmin/custombuild
    ./build rewrite_confs

    echo -e "${YELLOW}[INFO] Restarting Apache...${NC}"
    if systemctl restart httpd 2>/dev/null || systemctl restart apache2 2>/dev/null; then
        echo -e "${GREEN}[OK] Apache restarted${NC}"
    elif service httpd restart 2>/dev/null || service apache2 restart 2>/dev/null; then
        echo -e "${GREEN}[OK] Apache restarted via service${NC}"
    else
        echo -e "${YELLOW}[WARN] Could not restart Apache automatically${NC}"
    fi

    echo -e "${GREEN}[OK] 8G Firewall installed for DirectAdmin + Apache${NC}"
}

install_da_ols() {
    local da_templates="/usr/local/directadmin/data/templates"
    local da_custom="/usr/local/directadmin/data/templates/custom"
    local custom_file="$da_custom/openlitespeed_vhost.conf.CUSTOM.5.pre"

    echo -e "${YELLOW}[INFO] Installing for DirectAdmin + OpenLiteSpeed...${NC}"

    if [[ ! -d "$da_templates" ]]; then
        echo -e "${RED}Error: DirectAdmin templates not found${NC}"
        exit 1
    fi

    if [[ ! -f "$da_templates/openlitespeed_vhost.conf" ]]; then
        echo -e "${RED}Error: OpenLiteSpeed template not found${NC}"
        exit 1
    fi

    if [[ -f "$custom_file" ]]; then
        echo -e "${YELLOW}[WARN] CUSTOM.5.pre already exists${NC}"
        return 0
    fi

    mkdir -p "$da_custom"
    backup_file "$custom_file" "$BACKUP_DIR/8g-ols-custom5.$(date +%Y%m%d-%H%M%S).bak" 2>/dev/null || true

    {
        echo "$MARKER_START"
        echo "# 8G Firewall v1.5 - DirectAdmin + OpenLiteSpeed"
        echo "# Position: CUSTOM.5 (inside rewrite block)"
        echo "# $(date +%Y-%m-%d\ %H:%M:%S)"
        rewrite_rules
        echo "$MARKER_END"
    } > "$custom_file"

    chown diradmin:diradmin "$custom_file"
    chmod 644 "$custom_file"

    echo -e "${GREEN}[OK] Created: $custom_file${NC}"

    echo -e "${YELLOW}[INFO] Rebuilding OLS configs...${NC}"
    cd /usr/local/directadmin/custombuild
    ./build rewrite_confs

    echo -e "${YELLOW}[INFO] Restarting OpenLiteSpeed...${NC}"
    if /usr/local/lsws/bin/lswsctrl restart 2>/dev/null; then
        echo -e "${GREEN}[OK] OLS restarted${NC}"
    elif systemctl restart lshttpd 2>/dev/null; then
        echo -e "${GREEN}[OK] OLS restarted via systemctl${NC}"
    else
        echo -e "${YELLOW}[WARN] Could not restart OLS automatically${NC}"
    fi

    echo -e "${GREEN}[OK] 8G Firewall installed for DirectAdmin + OLS${NC}"
}

#===============================================================================
# UNINSTALL
#===============================================================================

uninstall() {
    echo -e "${YELLOW}[INFO] Uninstalling 8G Firewall...${NC}"

    # cPanel Apache / LiteSpeed
    local cpanel_conf="/etc/apache2/conf.d/includes/pre_virtualhost_global.conf"
    if [[ -f "$cpanel_conf" ]] && grep -q "$MARKER_START" "$cpanel_conf" 2>/dev/null; then
        local tmpfile
        tmpfile=$(mktemp)
        sed "/$MARKER_START/,/$MARKER_END/d" "$cpanel_conf" > "$tmpfile"
        mv "$tmpfile" "$cpanel_conf"
        echo -e "${GREEN}[OK] Removed from $cpanel_conf${NC}"
        if [[ "$PANEL" == "cpanel" ]]; then
            /scripts/rebuildhttpdconf
            if [[ "$WEBSERVER" == "litespeed" ]]; then
                /usr/local/lsws/bin/lswsctrl restart 2>/dev/null || service lsws restart 2>/dev/null || true
            else
                /scripts/restartsrv_httpd 2>/dev/null || true
            fi
        fi
    fi

    # DirectAdmin Apache
    local da_apache_conf="/usr/local/apache/conf/httpd.conf"
    local da_custom="/usr/local/apache/conf/extra/8g-firewall.conf"
    if [[ -f "$da_apache_conf" ]] && grep -q "8g-firewall.conf" "$da_apache_conf" 2>/dev/null; then
        sed -i '/8g-firewall.conf/d' "$da_apache_conf"
        rm -f "$da_custom"
        echo -e "${GREEN}[OK] Removed from DirectAdmin Apache${NC}"
        cd /usr/local/directadmin/custombuild 2>/dev/null && ./build rewrite_confs 2>/dev/null || true
    fi

    # DirectAdmin OLS
    local da_ols_custom="/usr/local/directadmin/data/templates/custom/openlitespeed_vhost.conf.CUSTOM.5.pre"
    if [[ -f "$da_ols_custom" ]]; then
        rm -f "$da_ols_custom"
        echo -e "${GREEN}[OK] Removed OLS custom template${NC}"
        cd /usr/local/directadmin/custombuild 2>/dev/null && ./build rewrite_confs 2>/dev/null || true
        /usr/local/lsws/bin/lswsctrl restart 2>/dev/null || true
    fi

    # cPanel nginx
    rm -f /etc/nginx/conf.d/8g-firewall-maps.conf
    rm -f /etc/nginx/conf.d/8g-firewall-server.conf
    if [[ -d /var/cpanel/templates/nginx ]]; then
        for tmpl in /var/cpanel/templates/nginx/*.tmpl /var/cpanel/templates/nginx/vhost/*.tmpl /var/cpanel/templates/nginx/vhost.local/*.tmpl 2>/dev/null; do
            [[ -f "$tmpl" ]] || continue
            sed -i '/8g-firewall-server.conf/d' "$tmpl"
        done
    fi
    if [[ -d /etc/nginx/conf.d/users ]]; then
        for user_conf in /etc/nginx/conf.d/users/*.conf; do
            [[ -f "$user_conf" ]] || continue
            sed -i '/8g-firewall-server.conf/d' "$user_conf"
        done
    fi
    nginx -t 2>/dev/null && /scripts/restartsrv_nginx 2>/dev/null || true

    echo -e "${GREEN}[OK] 8G Firewall uninstalled${NC}"
}

#===============================================================================
# STATUS
#===============================================================================

show_status() {
    echo -e "${BLUE}=== 8G Firewall Status ===${NC}"
    echo -e "Panel: ${PANEL:-unknown}"
    echo -e "Web Server: ${WEBSERVER:-unknown}"
    echo ""

    local found=0

    if [[ -f /etc/apache2/conf.d/includes/pre_virtualhost_global.conf ]]; then
        if grep -q "$MARKER_START" /etc/apache2/conf.d/includes/pre_virtualhost_global.conf 2>/dev/null; then
            echo -e "${GREEN}[INSTALLED] cPanel Apache/LiteSpeed${NC}"
            found=1
        fi
    fi

    if [[ -f /usr/local/apache/conf/extra/8g-firewall.conf ]]; then
        echo -e "${GREEN}[INSTALLED] DirectAdmin Apache${NC}"
        found=1
    fi

    if [[ -f /usr/local/directadmin/data/templates/custom/openlitespeed_vhost.conf.CUSTOM.5.pre ]]; then
        echo -e "${GREEN}[INSTALLED] DirectAdmin OLS${NC}"
        found=1
    fi

    if [[ -f /etc/nginx/conf.d/8g-firewall-maps.conf ]]; then
        echo -e "${GREEN}[INSTALLED] cPanel nginx (maps)${NC}"
        found=1
    fi

    if [[ $found -eq 0 ]]; then
        echo -e "${RED}[NOT INSTALLED]${NC}"
    fi
}

#===============================================================================
# MAIN
#===============================================================================

usage() {
    echo "Usage: $0 {install|uninstall|status|detect}"
    echo ""
    echo "  install   - Install 8G Firewall (default)"
    echo "  uninstall - Remove 8G Firewall"
    echo "  status    - Check installation status"
    echo "  detect    - Show detected environment"
    echo ""
    echo "Supported configurations:"
    echo "  - DirectAdmin + Apache"
    echo "  - DirectAdmin + OpenLiteSpeed"
    echo "  - cPanel + Apache"
    echo "  - cPanel + ea-nginx"
    echo "  - cPanel + LiteSpeed"
    exit 1
}

main() {
    check_root

    case "${1:-install}" in
        detect)
            detect_panel
            detect_webserver
            echo ""
            echo "Detected: $PANEL + $WEBSERVER"
            ;;
        install)
            detect_panel
            detect_webserver
            echo ""
            echo "============================================================"
            echo "  8G FIREWALL v1.5 - Unified Deployment"
            echo "  Target: $PANEL + $WEBSERVER"
            echo "============================================================"
            echo ""

            case "$PANEL:$WEBSERVER" in
                cpanel:apache)
                    install_cpanel_apache
                    ;;
                cpanel:litespeed)
                    install_cpanel_litespeed
                    ;;
                cpanel:nginx)
                    install_cpanel_nginx
                    ;;
                directadmin:apache)
                    install_da_apache
                    ;;
                directadmin:openlitespeed)
                    install_da_ols
                    ;;
                directadmin:litespeed)
                    echo -e "${YELLOW}[INFO] DirectAdmin + LiteSpeed Enterprise detected.${NC}"
                    echo -e "${YELLOW}        Treating as Apache-compatible configuration.${NC}"
                    install_da_apache
                    ;;
                *)
                    echo -e "${RED}Error: Unsupported combination: $PANEL + $WEBSERVER${NC}"
                    exit 1
                    ;;
            esac

            echo ""
            echo -e "${GREEN}=== Installation Complete ===${NC}"
            echo -e "${YELLOW}Backups saved to: $BACKUP_DIR${NC}"
            echo ""
            echo "Test with: curl -I 'http://yourdomain.com/?cmd=shell'"
            echo "Expected: HTTP/1.1 403 Forbidden"
            ;;
        uninstall)
            detect_panel
            detect_webserver
            uninstall
            ;;
        status)
            detect_panel
            detect_webserver
            show_status
            ;;
        *)
            usage
            ;;
    esac
}

main "$@"
