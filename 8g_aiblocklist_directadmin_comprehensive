#!/bin/bash
#===============================================================================
# 8G FIREWALL v1.5 - Unified Deployment Script
# Supports:
#   - DirectAdmin + Apache
#   - DirectAdmin + OpenLiteSpeed
#   - cPanel + Apache
#   - cPanel + ea-nginx
#   - cPanel + LiteSpeed
#===============================================================================

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

BACKUP_DIR="/root/8g-firewall-backups"
MARKER_START="# === 8G FIREWALL START ==="
MARKER_END="# === 8G FIREWALL END ==="

#===============================================================================
# UTILITIES
#===============================================================================

check_root() {
    if [[ "$(id -u)" != "0" ]]; then
        echo -e "${RED}Error: This script must be run as root${NC}"
        exit 1
    fi
}

backup_file() {
    local src="$1"
    local dst="$2"
    mkdir -p "$BACKUP_DIR"
    if [[ -f "$src" ]]; then
        cp -a "$src" "$dst"
        echo -e "${GREEN}[OK] Backup: $dst${NC}"
    fi
}

#===============================================================================
# DETECTION
#===============================================================================

detect_panel() {
    if [[ -d /usr/local/cpanel && -f /usr/local/cpanel/cpanel ]]; then
        PANEL="cpanel"
    elif [[ -d /usr/local/directadmin && -f /usr/local/directadmin/directadmin ]]; then
        PANEL="directadmin"
    else
        echo -e "${RED}Error: No supported panel detected (cPanel or DirectAdmin)${NC}"
        exit 1
    fi
    echo -e "${BLUE}[INFO] Panel: $PANEL${NC}"
}

detect_webserver() {
    case "$PANEL" in
        cpanel)
            if [[ -d /etc/nginx && -f /etc/nginx/nginx.conf ]] && { rpm -q ea-nginx &>/dev/null || [[ -f /etc/nginx/nginx.conf ]]; }; then
                # Distinguish nginx-only vs nginx+apache
                if [[ ! -f /usr/sbin/httpd && ! -f /usr/local/apache/bin/httpd && ! -d /etc/apache2/conf.d ]]; then
                    WEBSERVER="nginx"
                elif [[ -f /usr/local/lsws/bin/lshttpd ]] || pgrep -x "litespeed" &>/dev/null; then
                    WEBSERVER="litespeed"
                else
                    WEBSERVER="apache"
                fi
            elif [[ -f /usr/local/lsws/bin/lshttpd ]] || pgrep -x "litespeed" &>/dev/null; then
                WEBSERVER="litespeed"
            elif [[ -f /usr/sbin/httpd || -f /usr/local/apache/bin/httpd || -d /etc/apache2/conf.d ]]; then
                WEBSERVER="apache"
            else
                echo -e "${RED}Error: Could not detect web server on cPanel${NC}"
                exit 1
            fi
            ;;
        directadmin)
            local cb_options="/usr/local/directadmin/custombuild/options.conf"
            if [[ -f "$cb_options" ]]; then
                local ws
                ws=$(grep "^webserver=" "$cb_options" 2>/dev/null | cut -d= -f2)
                case "$ws" in
                    openlitespeed) WEBSERVER="openlitespeed" ;;
                    litespeed)     WEBSERVER="litespeed" ;;
                    nginx)         WEBSERVER="nginx" ;;
                    *)             WEBSERVER="apache" ;;
                esac
            else
                if [[ -f /usr/local/lsws/bin/lshttpd ]]; then
                    WEBSERVER="openlitespeed"
                elif [[ -f /usr/local/apache/bin/httpd || -f /usr/sbin/httpd ]]; then
                    WEBSERVER="apache"
                else
                    echo -e "${RED}Error: Could not detect web server on DirectAdmin${NC}"
                    exit 1
                fi
            fi
            ;;
    esac
    echo -e "${BLUE}[INFO] Web server: $WEBSERVER${NC}"
}

