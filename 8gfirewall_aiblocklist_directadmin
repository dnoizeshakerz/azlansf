#!/bin/bash
#===============================================================================
# 8G FIREWALL v1.5 - Global Deployment Script for DirectAdmin + Apache
# Date: 2026-06-02
# Description: Installs 8G Firewall rules globally for all Apache virtual hosts
#===============================================================================

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Configuration paths
APACHE_CONF=""
APACHE_CONF_DIR=""
APACHE_CONF_D=""
CUSTOM_CONF=""
BACKUP_DIR="/root/8g-firewall-backups"
APACHE_BIN=""

#===============================================================================
# Functions
#===============================================================================

check_root() {
    if [ "$(id -u)" != "0" ]; then
        echo -e "${RED}Error: This script must be run as root${NC}"
        exit 1
    fi
}

detect_apache() {
    echo -e "${YELLOW}[INFO] Detecting Apache installation...${NC}"

    # DirectAdmin typically uses /usr/local/apache/
    if [ -f /usr/local/apache/bin/httpd ]; then
        APACHE_BIN="/usr/local/apache/bin/httpd"
        APACHE_CONF="/usr/local/apache/conf/httpd.conf"
        APACHE_CONF_DIR="/usr/local/apache/conf/extra"
        APACHE_CONF_D="/usr/local/apache/conf/conf.d"
        CUSTOM_CONF="/usr/local/apache/conf/extra/8g-firewall.conf"
    elif [ -f /usr/local/apache2/bin/httpd ]; then
        APACHE_BIN="/usr/local/apache2/bin/httpd"
        APACHE_CONF="/usr/local/apache2/conf/httpd.conf"
        APACHE_CONF_DIR="/usr/local/apache2/conf/extra"
        APACHE_CONF_D="/usr/local/apache2/conf/conf.d"
        CUSTOM_CONF="/usr/local/apache2/conf/extra/8g-firewall.conf"
    elif [ -f /etc/httpd/bin/httpd ]; then
        APACHE_BIN="/etc/httpd/bin/httpd"
        APACHE_CONF="/etc/httpd/conf/httpd.conf"
        APACHE_CONF_DIR="/etc/httpd/conf/extra"
        APACHE_CONF_D="/etc/httpd/conf.d"
        CUSTOM_CONF="/etc/httpd/conf/extra/8g-firewall.conf"
    elif [ -f /usr/sbin/httpd ]; then
        APACHE_BIN="/usr/sbin/httpd"
        if [ -f /etc/httpd/conf/httpd.conf ]; then
            APACHE_CONF="/etc/httpd/conf/httpd.conf"
            APACHE_CONF_DIR="/etc/httpd/conf/extra"
            APACHE_CONF_D="/etc/httpd/conf.d"
            CUSTOM_CONF="/etc/httpd/conf/extra/8g-firewall.conf"
        elif [ -f /etc/apache2/apache2.conf ]; then
            APACHE_CONF="/etc/apache2/apache2.conf"
            APACHE_CONF_DIR="/etc/apache2/conf-available"
            APACHE_CONF_D="/etc/apache2/conf.d"
            CUSTOM_CONF="/etc/apache2/conf-available/8g-firewall.conf"
        fi
    elif command -v httpd >/dev/null 2>&1; then
        APACHE_BIN=$(command -v httpd)
        # Try to find config
        APACHE_CONF=$($APACHE_BIN -V 2>/dev/null | grep SERVER_CONFIG_FILE | awk -F'"' '{print $2}')
        if [ -z "$APACHE_CONF" ] || [ ! -f "$APACHE_CONF" ]; then
            APACHE_CONF="/etc/httpd/conf/httpd.conf"
        fi
        APACHE_CONF_DIR=$(dirname "$APACHE_CONF")/extra
        APACHE_CONF_D=$(dirname "$APACHE_CONF")/conf.d
        CUSTOM_CONF="$APACHE_CONF_DIR/8g-firewall.conf"
    else
        echo -e "${RED}Error: Apache (httpd) not found${NC}"
        exit 1
    fi

    if [ ! -f "$APACHE_CONF" ]; then
        echo -e "${RED}Error: Apache config not found at $APACHE_CONF${NC}"
        exit 1
    fi

    APACHE_VERSION=$($APACHE_BIN -v 2>/dev/null | head -1 | grep -oE 'Apache/[0-9]+\.[0-9]+' | head -1 || echo "unknown")
    echo -e "${GREEN}[OK] Apache: $APACHE_VERSION${NC}"
    echo -e "${GREEN}[OK] Binary: $APACHE_BIN${NC}"
    echo -e "${GREEN}[OK] Config: $APACHE_CONF${NC}"
    echo -e "${GREEN}[OK] Extra dir: $APACHE_CONF_DIR${NC}"
}

create_backup() {
    echo -e "${YELLOW}[INFO] Creating backups...${NC}"
    mkdir -p "$BACKUP_DIR"

    if [ -f "$APACHE_CONF" ]; then
        cp "$APACHE_CONF" "$BACKUP_DIR/httpd.conf.backup.$(date +%Y%m%d_%H%M%S)"
    fi

    if [ -f "$CUSTOM_CONF" ]; then
        cp "$CUSTOM_CONF" "$BACKUP_DIR/8g-firewall.conf.backup.$(date +%Y%m%d_%H%M%S)"
    fi

    echo -e "${GREEN}[OK] Backups saved to $BACKUP_DIR${NC}"
}

create_8g_config() {
    echo -e "${YELLOW}[INFO] Creating 8G Firewall configuration...${NC}"

