update_httpd_conf() {
    echo -e "${YELLOW}[INFO] Updating Apache configuration...${NC}"

    # Check if already included
    if grep -q "8g-firewall.conf" "$APACHE_CONF" 2>/dev/null; then
        echo -e "${YELLOW}[WARN] 8G Firewall Include already exists in $APACHE_CONF${NC}"
        return 0
    fi

    # Find best insertion point - before first VirtualHost or Include
    INSERT_LINE=$(grep -n -m1 -E '^\s*<VirtualHost|^\s*IncludeOptional\s|^\s*Include\s' "$APACHE_CONF" 2>/dev/null | head -1 | cut -d: -f1)

    if [ -z "$INSERT_LINE" ]; then
        # No VirtualHost found, append before end
        INSERT_LINE=$(wc -l < "$APACHE_CONF")
    fi

    # Create temp file with proper content
    TMP_FILE=$(mktemp)
    head -n $((INSERT_LINE - 1)) "$APACHE_CONF" > "$TMP_FILE"
    echo "" >> "$TMP_FILE"
    echo "# 8G FIREWALL GLOBAL INCLUDE - Added $(date +%Y-%m-%d)" >> "$TMP_FILE"
    echo "Include $CUSTOM_CONF" >> "$TMP_FILE"
    echo "" >> "$TMP_FILE"
    tail -n +$INSERT_LINE "$APACHE_CONF" >> "$TMP_FILE"

    mv "$TMP_FILE" "$APACHE_CONF"
    chmod 644 "$APACHE_CONF"

    echo -e "${GREEN}[OK] Added Include directive to $APACHE_CONF at line $INSERT_LINE${NC}"
}

check_apache_syntax() {
    echo -e "${YELLOW}[INFO] Checking Apache configuration syntax...${NC}"

    if $APACHE_BIN -t 2>&1; then
        echo -e "${GREEN}[OK] Apache configuration syntax is valid${NC}"
        return 0
    else
        echo -e "${RED}[FAIL] Apache configuration syntax error!${NC}"
        echo -e "${YELLOW}[INFO] Restoring from backup...${NC}"

        LATEST_BACKUP=$(ls -t "$BACKUP_DIR"/httpd.conf.backup.* 2>/dev/null | head -1)
        if [ -n "$LATEST_BACKUP" ]; then
            cp "$LATEST_BACKUP" "$APACHE_CONF"
            echo -e "${GREEN}[OK] Restored from $LATEST_BACKUP${NC}"
        fi

        return 1
    fi
}

reload_apache() {
    echo -e "${YELLOW}[INFO] Reloading Apache...${NC}"

    if systemctl reload httpd 2>/dev/null || systemctl reload apache2 2>/dev/null; then
        echo -e "${GREEN}[OK] Apache reloaded via systemctl${NC}"
    elif service httpd reload 2>/dev/null || service apache2 reload 2>/dev/null; then
        echo -e "${GREEN}[OK] Apache reloaded via service${NC}"
    elif $APACHE_BIN -k graceful 2>/dev/null; then
        echo -e "${GREEN}[OK] Apache reloaded gracefully${NC}"
    else
        echo -e "${YELLOW}[WARN] Could not reload automatically. Run: $APACHE_BIN -k graceful${NC}"
    fi
}

verify_mod_rewrite() {
    echo -e "${YELLOW}[INFO] Checking mod_rewrite...${NC}"

    if $APACHE_BIN -M 2>/dev/null | grep -q "rewrite_module"; then
        echo -e "${GREEN}[OK] mod_rewrite is enabled${NC}"
    elif [ -d "$APACHE_CONF_D" ] && grep -r "rewrite_module" "$APACHE_CONF_D"/*.conf >/dev/null 2>&1; then
        echo -e "${GREEN}[OK] mod_rewrite is loaded${NC}"
    else
        echo -e "${RED}[WARN] mod_rewrite may not be enabled!${NC}"
        echo -e "${YELLOW}Enable with: cd /usr/local/directadmin/custombuild && ./build set mod_rewrite yes && ./build rewrite_confs${NC}"
    fi
}

uninstall() {
    echo -e "${YELLOW}[INFO] Uninstalling 8G Firewall...${NC}"

    if [ -f "$APACHE_CONF" ]; then
        # Remove include line and comment
        sed -i '/# 8G FIREWALL GLOBAL INCLUDE/d' "$APACHE_CONF"
        sed -i "/Include $CUSTOM_CONF/d" "$APACHE_CONF"
        echo -e "${GREEN}[OK] Removed Include from $APACHE_CONF${NC}"
    fi

    if [ -f "$CUSTOM_CONF" ]; then
        mv "$CUSTOM_CONF" "$BACKUP_DIR/8g-firewall.conf.removed.$(date +%Y%m%d_%H%M%S)"
        echo -e "${GREEN}[OK] Removed $CUSTOM_CONF${NC}"
    fi

    if $APACHE_BIN -t 2>/dev/null; then
        reload_apache
        echo -e "${GREEN}[OK] Uninstalled successfully${NC}"
    else
        echo -e "${RED}[WARN] Apache config test failed after removal${NC}"
    fi
}

show_status() {
    echo -e "${YELLOW}=== 8G Firewall Status ===${NC}"

    if [ -f "$CUSTOM_CONF" ]; then
        echo -e "${GREEN}Status: INSTALLED${NC}"
        echo -e "Config: $CUSTOM_CONF"
        echo -e "Rules: $(grep -cE 'RewriteCond|RewriteRule' "$CUSTOM_CONF") conditions/rules"
    else
        echo -e "${RED}Status: NOT INSTALLED${NC}"
    fi

    if grep -q "8g-firewall.conf" "$APACHE_CONF" 2>/dev/null; then
        echo -e "${GREEN}Included in: $APACHE_CONF${NC}"
    else
        echo -e "${RED}Not included in Apache config${NC}"
    fi
}

